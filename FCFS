#include<stdio.h>

int main(){
int n;
 printf("Enter the no. of process : ");
    scanf("%d",&n);

  int P[n],AT[n],BT[n],CT[n],TAT[n],WT[n];
  

     for(int i=0;i<n;i++)
{      printf("Enter the Arrival time for process %d\n",i+1);
          scanf("%d",&AT[i]);
         printf("Enter the Burst time for process %d\n",i+1);
          scanf("%d",&BT[i]);
}

    for(int i=0;i<n;i++){
      printf("Arrive %d ",AT[i]);
      printf("Burst %d ",BT[i]);
}
     CT[0]=AT[0]+BT[0];
     for(int i=1;i<n;i++){
      if(CT[i-1] < AT[i])
       CT[i]=AT[i]+BT[i];

       else
       CT[i]=CT[i-1]+BT[i];
}

      for(int i=0;i<n;i++){
       TAT[i]=CT[i]-AT[i];
       WT[i]=TAT[i]-BT[i];
}

       for(int i=0;i<n;i++){
        printf("\n");
         printf("ct :%d, TAT :%d , WT :%d",CT[i],TAT[i],WT[i]);

}
return 0;
}





