/* Create a n size arry and find the average then find the element of array greater than average. */
#include <stdio.h>

int main() {
    int n;
    printf("Enter the size of array : ");
    scanf("%d",& n);

    int arr[n], sum = 0, sum1 = 0;

    for (int i = 0; i < n; i++) {
        printf("Enter element %d: ", i + 1);
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    float average = sum / n;
    printf("Average = %d\n", average);

    printf("Elements greater than average:\n");
    for (int i = 0; i < n; i++) {
        if (arr[i] > average) {
            printf("%d\n", arr[i]);
            sum1 += arr[i];
        }
    }

    printf("Sum of elements greater than average = %d\n", sum1);

    return 0;
}
